# Supabase Configuration & Credentials

# 1. Supabase Project URL (Public / Safe for browser bundle)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Publishable / Anon Key (Public / Safe for browser bundle)
# This key is governed strictly by PostgreSQL Row Level Security (RLS) policies.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Optional Local Feature Flags
VITE_APP_ENV=development
